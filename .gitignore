# ==============================================
# Игнорирование сгенерированных директорий Vivado
# ==============================================

# Основные рабочие директории
**.Xil/
**.ipcache/
**.run/
**.runs/
**.hw/
**.sim/
**.ip_user_files/
**.srcs/utils/
**.gen/
**.tmp/
**.cache/

# Файлы логов, отчётов и журналов
*.log
*.jou
*.str
*.rpt
*.pb
*.vds
*.wdb
*.vcd

# Бинарные и итоговые файлы прошивок
*.bit
*.bin
*.mcs
*.prm
*.ltx

# Файлы, специфичные для ОС и редакторов
Thumbs.db
.DS_Store
*.swp
*.swo
*~
*.bak

# ==============================================
# Исключения: файлы, которые необходимо хранить в Git
# ==============================================

# Не игнорировать основной файл проекта
!*.xpr

# Не игнорировать TCL-скрипты (ключевые для воспроизведения проекта)
!*.tcl

# Не игнорировать файлы исходных кодов (SystemVerilog, Verilog, VHDL)
!*.sv
!*.v
!*.vhd

# Не игнорировать файлы блок-диаграмм (Block Design) и констрейнов
!*.bd
!*.xdc

# Не игнорировать исходные файлы IP-ядер (XCI) и COE-файлы для памяти
!*.xci
!*.coe

# Сгенерированные TCL-скрипты (скрипты запуска, симуляции и т.п.)
**/*.runs/**/*.tcl
**/*.sim/**/*.tcl
**/*.cache/**/*.tcl
**/*.hw/**/*.tcl
**/*.ip_user_files/**/*.tcl
